# The ZAO app (bettercallzaal/zao-app) environment variable NAMES. Values are never committed.
# Copy the values from the ZAOOS Vercel project settings (or your own accounts) into .env.local.

# Required at module load (src/lib/env.ts). The build and the app throw without these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_NEYNAR_CLIENT_ID=
SUPABASE_SERVICE_ROLE_KEY=
NEYNAR_API_KEY=
SESSION_SECRET=
APP_FID=
APP_SIGNER_PRIVATE_KEY=

# Public app URLs and sign-in
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_URL=
NEXT_PUBLIC_SIWF_DOMAIN=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_OPTIMISM_RPC_URL=
NEXT_PUBLIC_FARCASTER_FOLLOWING_FEED=
NEXT_PUBLIC_SENTRY_DSN=

# Farcaster read and write behaviour
FARCASTER_READ_API_BASE=
FARCASTER_SIGNER_AUTHORITY_FILTER=
FARCASTER_WRITE_SIGNER_CHECK=
HIDDEN_CASTS_EVERYWHERE=
NEYNAR_WEBHOOK_SECRET=

# Official ZAO account (managed signer)
ZAO_OFFICIAL_FID=
ZAO_OFFICIAL_SIGNER_UUID=
ZAO_OFFICIAL_NEYNAR_API_KEY=

# Rate limits (Upstash Redis) and cron
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=

# Content moderation and feature-specific keys (optional)
PERSPECTIVE_API_KEY=
ZX_API_KEY=
ALCHEMY_API_KEY=
EMPIRE_BUILDER_API_KEY=
SOPHA_API_USERNAME=
SOPHA_API_PASSWORD=
LASTFM_API_KEY=
LASTFM_API_SECRET=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_KICK_CLIENT_ID=
NEXT_PUBLIC_TWITCH_CLIENT_ID=
